# Copy this file and rename the copy to ".env.local", then fill in your keys.
# NEVER upload .env.local to GitHub (it is already ignored).
# The site still works without these — the features just stay off.

# --- AI chat: set ONE of these. Gemini is used first if both are set. ---
# Google Gemini (free tier): aistudio.google.com → Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude (paid): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# --- Contact form email (resend.com → API Keys) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=miguelitochesterpawig@gmail.com
# After you verify your own domain in Resend, change this and set auto-reply to true
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_AUTO_REPLY=false

# --- Captcha on the contact form (dash.cloudflare.com → Turnstile → Add widget) ---
# Add your site's domain (and "localhost" for testing). Both keys are needed to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Save messages to a database (supabase.com → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
